# Target of the Vite dev proxy for a locally running `m3m0s serve` (only used
# by `npm run dev` — in production the WebUI is served by `m3m0s serve`
# itself, same-origin, with no proxy and no need for this variable).
VITE_M3M0S_PROXY_TARGET=http://localhost:19234

# Optional override: forces the WebUI client to point at a remote
# `m3m0s serve` instead of same-origin. Leave empty in the common case.
# VITE_M3M0S_URL=
