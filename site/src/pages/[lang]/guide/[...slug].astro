---
import GuidePage from "../../../components/GuidePage.astro";
import { sortedGuide, slugOf } from "../../../lib/guide";
import { LOCALES, DEFAULT_LANG, type Lang } from "../../../i18n";

export async function getStaticPaths() {
  const out = [];
  for (const lang of LOCALES.filter((l) => l !== DEFAULT_LANG)) {
    const entries = await sortedGuide(lang);
    entries.forEach((entry, i) =>
      out.push({
        params: { lang, slug: slugOf(entry) === "index" ? undefined : slugOf(entry) },
        props: { entry, prev: entries[i - 1], next: entries[i + 1] },
      }),
    );
  }
  return out;
}
const lang = Astro.params.lang as Lang;
const { entry, prev, next } = Astro.props;
---
<GuidePage lang={lang} entry={entry} prev={prev} next={next} />
