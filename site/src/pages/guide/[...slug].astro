---
import GuidePage from "../../components/GuidePage.astro";
import { sortedGuide, slugOf } from "../../lib/guide";

export async function getStaticPaths() {
  const entries = await sortedGuide("en");
  return entries.map((entry, i) => ({
    params: { slug: slugOf(entry) === "index" ? undefined : slugOf(entry) },
    props: { entry, prev: entries[i - 1], next: entries[i + 1] },
  }));
}
const { entry, prev, next } = Astro.props;
---
<GuidePage lang="en" entry={entry} prev={prev} next={next} />
