---
import { t, localePath, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <span>© {year} Rafael Vieiras · {d.footer.license}</span>
    <nav class="footer-links" aria-label={d.footer.footer}>
      <a href={localePath(lang, "/guide/")}>{d.nav.guide}</a>
      <a href="https://github.com/rafaelvieiras/m3m0s" rel="noopener">GitHub</a>
      <a href="https://github.com/rafaelvieiras/m3m0s/releases" rel="noopener">{d.footer.releases}</a>
      <a href="https://github.com/rafaelvieiras/m3m0s/blob/main/SECURITY.md" rel="noopener">{d.footer.security}</a>
    </nav>
  </div>
</footer>
