---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import GuideNav from "./GuideNav.astro";
import { sortedGuide, guideHref, ogPathFor, slugOf, type GuideEntry } from "../lib/guide";
import { t, localePath, LANG_META, type Lang } from "../i18n";

interface Props { lang: Lang; entry: GuideEntry; prev?: GuideEntry; next?: GuideEntry }
const { lang, entry, prev, next } = Astro.props;
const d = t(lang);
const slug = slugOf(entry);
const entries = await sortedGuide(lang);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const isIndex = slug === "index";
const title = isIndex ? d.guide.indexTitle : `${entry.data.title} · ${d.guide.titleSuffix}`;
const abs = (p: string) => new URL(p, Astro.site).href;
const url = abs(guideHref(lang, entry));
const mdHref = localePath(lang, isIndex ? "/guide/index.md" : `/guide/${slug}.md`);
const jsonLd = [
  {
    "@type": "TechArticle",
    "@id": `${url}#article`,
    headline: entry.data.title,
    description: entry.data.description,
    url,
    inLanguage: LANG_META[lang].html,
    isPartOf: { "@id": abs("/#website") },
    about: { "@id": abs("/#software") },
    author: { "@type": "Person", name: "Rafael Vieiras", url: "https://github.com/rafaelvieiras" },
    image: abs(ogPathFor(lang, entry)),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "m3m0s", item: abs(localePath(lang, "/")) },
      { "@type": "ListItem", position: 2, name: d.nav.guide, item: abs(localePath(lang, "/guide/")) },
      ...(isIndex ? [] : [{ "@type": "ListItem", position: 3, name: entry.data.title, item: url }]),
    ],
  },
];
---
<Base lang={lang} title={title} description={entry.data.description} ogImage={ogPathFor(lang, entry)} type="article" jsonLd={jsonLd} markdownHref={mdHref}>
  <div class="container">
    <div class:list={["guide", toc.length > 1 && "has-toc"]}>
      <details class="side-mobile">
        <summary>{d.guide.menu}</summary>
        <GuideNav entries={entries} currentId={entry.id} lang={lang} />
      </details>
      <GuideNav entries={entries} currentId={entry.id} lang={lang} />
      <article class="prose">
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        <Content />
        <nav class="pager" aria-label={d.guide.pagination}>
          {prev && <a class="prev" href={guideHref(lang, prev)}><small>{d.guide.previous}</small>{prev.data.title}</a>}
          {next && <a class="next" href={guideHref(lang, next)}><small>{d.guide.next}</small>{next.data.title}</a>}
        </nav>
        <p class="edit-link">
          <a href={`https://github.com/rafaelvieiras/m3m0s/edit/main/site/src/content/guide/${entry.id}.md`} rel="noopener">{d.guide.edit}</a>
        </p>
      </article>
      {toc.length > 1 && (
        <aside class="toc" aria-label={d.guide.onThisPage}>
          <h4>{d.guide.onThisPage}</h4>
          <ul>
            {toc.map((h) => <li><a class={`d${h.depth}`} href={`#${h.slug}`}>{h.text}</a></li>)}
          </ul>
        </aside>
      )}
    </div>
  </div>
</Base>
