---
import Logo from "./Logo.astro";
import { t, localePath, splitPath, LOCALES, LANG_META, type Lang } from "../i18n";
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const { path } = splitPath(Astro.url.pathname);
const inGuide = path.startsWith("/guide");
---
<header class="site-header">
  <div class="container">
    <a class="brand" href={localePath(lang, "/")} aria-label={d.nav.home}><Logo height={30} /> <span>m3m0s</span></a>
    <nav class="nav" aria-label={d.nav.main}>
      <a href={localePath(lang, "/guide/")} aria-current={inGuide ? "page" : undefined}>{d.nav.guide}</a>
      <a class="gh" href="https://github.com/rafaelvieiras/m3m0s" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>GitHub</span>
      </a>
      <details class="lang-menu">
        <summary aria-label={d.nav.language} title={d.nav.language}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>
          <span>{lang.toUpperCase()}</span>
        </summary>
        <ul>
          {LOCALES.map((l) => (
            <li><a href={localePath(l, path)} hreflang={LANG_META[l].html} lang={LANG_META[l].html} aria-current={l === lang ? "true" : undefined}>{LANG_META[l].label}</a></li>
          ))}
        </ul>
      </details>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label={d.nav.theme} title={d.nav.theme}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>
<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", function () {
    var root = document.documentElement;
    var current = root.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    var next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch (e) {}
  });
</script>
