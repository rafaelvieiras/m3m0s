---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t, LOCALES, LANG_META, localePath, splitPath, DEFAULT_LANG, type Lang } from "../i18n";

interface Props {
  title: string;
  description: string;
  ogImage: string;
  lang: Lang;
  type?: "website" | "article";
  /** Locales this page exists in (defaults to all). */
  alternates?: Lang[];
  /** Extra schema.org nodes for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Raw Markdown twin of this page, for LLM clients. */
  markdownHref?: string;
}
const { title, description, ogImage, lang, type = "website", alternates = [...LOCALES], jsonLd = [], markdownHref } = Astro.props;
const d = t(lang);
const { path } = splitPath(Astro.url.pathname);
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(Astro.url.pathname);
const og = abs(ogImage);
const graph = [
  {
    "@type": "WebSite",
    "@id": abs("/#website"),
    url: abs("/"),
    name: "m3m0s",
    description: d.site.tagline,
    inLanguage: LANG_META[lang].html,
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang={LANG_META[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    {alternates.map((l) => <link rel="alternate" hreflang={LANG_META[l].html} href={abs(localePath(l, path))} />)}
    {alternates.includes(DEFAULT_LANG) && <link rel="alternate" hreflang="x-default" href={abs(localePath(DEFAULT_LANG, path))} />}
    {markdownHref && <link rel="alternate" type="text/markdown" href={abs(markdownHref)} />}
    <link rel="alternate" type="text/plain" href={abs("/llms.txt")} title="llms.txt" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta property="og:site_name" content="m3m0s" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={LANG_META[lang].og} />
    {alternates.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].og} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skip}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
