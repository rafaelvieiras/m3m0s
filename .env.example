# Copy to .env (gitignored) and fill in with real values. Used by
# `compose.yaml` via `env_file` — NEVER commit .env nor log its values.

# Required: used for embeddings (text-embedding-3-small), see
# docs/api-contract.md.
OPENAI_API_KEY=

# Optional — fact extraction via LLM (Phase 4, D12). Absent/empty: extraction
# is turned off, with no error (each `memory_add` becomes 1 raw entry,
# pre-Phase-4 behavior).
# M3M0S_EXTRACT_API_KEY=
# M3M0S_EXTRACT_BASE_URL=
# M3M0S_EXTRACT_MODEL=
